REQUIRE_AUTH=true
HOST=127.0.0.1
PORT=2048
# REQUIRED IN PRODUCTION: a random value of at least 32 characters, e.g. `openssl rand -hex 32`.
# The server refuses to start in production if JWT_SECRET is missing, weak, or a known default.
JWT_SECRET=change-this-secret
# Comma-separated browser origins allowed to call the API (admin dashboard, mobile web).
# Empty = allow any origin (development only; the app warns about this in production).
CORS_ORIGINS=
PARENT_TOKEN_TTL=7d
DEVICE_TOKEN_TTL=365d
PAIRING_TTL_MINUTES=5
DATA_FILE=data/store.json
CONTENT_STORAGE=postgres
MEDIA_ROOT=media
# Set true to enforce HMAC signed /media URLs (requires client support). Default false.
MEDIA_REQUIRE_SIGNED_URLS=false
# Per-file upload cap in MB. Must fit the largest single video (5-6 GB uploads => 8192).
# The nginx client_max_body_size caps the whole multipart body and must be >= this.
MAX_VIDEO_UPLOAD_MB=8192
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCODER_ENABLED=true
OTP_TTL_MINUTES=10
OTP_DEFAULT_CODE=
OTP_DEBUG=false
SMTP_SECURE=false

# Legacy /api/v1 PostgreSQL API
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/astir
# Remote PostgreSQL hosts use SSL automatically. Set DATABASE_SSL=false only if that host does not support SSL.
DATABASE_SSL=
# Keep this TRUE in production so the DB certificate is validated. false disables
# certificate checks and exposes DB traffic to man-in-the-middle attacks.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME=Super Admin
MEDIA_SIGNING_SECRET=astir-local-media-secret

# External integrations. Missing values make provider endpoints skip delivery or return 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=astiranimation
FIREBASE_API_URL=https://fcm.googleapis.com/v1/projects/astiranimation/messages:send
CHILD_APP_OPEN_NOTIFICATION_COOLDOWN_SECONDS=300
# Comma-separated OAuth client IDs accepted in Google ID token aud.
GOOGLE_CLIENT_IDS=
# Backward-compatible alias still accepted by the backend.
GOOGLE_CLIENT_ID=
# Comma-separated app Bundle IDs / Service IDs accepted in Apple identity token aud.
APPLE_CLIENT_IDS=
# Backward-compatible alias still accepted by the backend.
APPLE_CLIENT_ID=
# Sign in with Apple key (Apple Developer > Keys) used to revoke Apple access
# when a user deletes the account (App Store Guideline 5.1.1(v)).
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path to AuthKey_XXXXXXXXXX.p8, or put the key itself in APPLE_PRIVATE_KEY.
APPLE_PRIVATE_KEY_PATH=
APPLE_PRIVATE_KEY=

CLICK_PAYMENT_URL=https://my.click.uz/services/pay
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=
CLICK_DEFAULT_SUBSCRIPTION_DAYS=30

# In-App Purchase verification. Purchases are verified server-side against the
# store APIs; without these credentials /billing/{apple,google}/verify returns 503.
# App Store Connect > Users and Access > Integrations > In-App Purchase key.
APPLE_IAP_BUNDLE_ID=uz.astiranimation.astir
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Path to SubscriptionKey_XXXXXXXXXX.p8, or put the key itself in APPLE_IAP_PRIVATE_KEY.
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_PRIVATE_KEY=
# auto (production, then sandbox for TestFlight / App Review) | production | sandbox
APPLE_IAP_ENVIRONMENT=auto
# Comma-separated store_product_id:tariff_id pairs.
APPLE_IAP_PRODUCTS=astir.premium.monthly:premium
# Google Play Developer API (service account with "View financial data" + "Manage orders").
GOOGLE_PLAY_PACKAGE_NAME=com.turgunovtech.astir_mobile
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=
GOOGLE_PLAY_PRODUCTS=astir.premium.monthly:premium
